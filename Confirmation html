<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Entry Confirmed — Dead Culture</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>&#9760;</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --void: #0B0B0C; --ink: #E7E4DD; --ink-soft: #8C8880; --rule: #29282A; --blood: #8A1216;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); height: 100%; }
  :root[data-theme="light"] {
    --void: #F1EFEA; --ink: #17151A; --ink-soft: #5C5852; --rule: #D7D2C8; --blood: #7A1014;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--void); color: var(--ink);
    font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased;
    display: flex; align-items: center; justify-content: center;
  }
  .wrap { max-width: 460px; width: 100%; margin: 0 auto; padding: 48px 24px; text-align: center; }
  .kicker { font-size: 11px; letter-spacing: 0.22em; color: var(--blood); margin: 0 0 14px; text-transform: uppercase; }
  h1 {
    font-family: 'Cinzel', serif; font-size: clamp(26px, 7vw, 34px); font-weight: 600;
    margin: 0 0 18px; letter-spacing: 0.02em; text-transform: uppercase;
  }
  p { color: var(--ink-soft); font-size: 15px; margin: 0 0 28px; }
  .ref-box {
    border: 1px solid var(--rule); padding: 20px; margin-bottom: 28px;
  }
  .ref-box .label { font-size: 11px; letter-spacing: 0.1em; color: var(--ink-soft); text-transform: uppercase; margin-bottom: 8px; }
  .ref-box .code { font-family: 'Cinzel', serif; font-size: 22px; letter-spacing: 0.05em; color: var(--blood); }
  .hint { font-size: 12.5px; color: var(--ink-soft); }
  footer { margin-top: 40px; font-size: 12px; color: var(--ink-soft); }
  .not-found { display: none; }
</style>
</head>
<body>
<div class="wrap">
  <p class="kicker">Payment Received</p>
  <h1>You're Entered</h1>
  <p id="mainMessage">Thank you for entering the Dead Culture contest. Keep your reference code below — it links your payment to your submission.</p>

  <div class="ref-box" id="refBox">
    <div class="label">Your Entry Reference</div>
    <div class="code" id="refCode">—</div>
  </div>

  <p class="hint" id="nameHint"></p>

  <div class="not-found" id="notFound">
    <p>We couldn't find your entry details on this device. If you submitted the form and paid, your entry is still recorded — just make a note of your PayPal payment confirmation in case we need to match it up.</p>
  </div>

  <footer>Questions? Message us on Instagram — @Dead_Culture_Press</footer>
</div>

<script>
  let ref = null;
  let name = null;
  try {
    ref = localStorage.getItem('dcEntryRef');
    name = localStorage.getItem('dcEntryName');
  } catch (err) {}

  if (ref) {
    document.getElementById('refCode').textContent = ref;
    if (name) {
      document.getElementById('nameHint').textContent = 'Entered as ' + name + '.';
    }
  } else {
    document.getElementById('refBox').style.display = 'none';
    document.getElementById('notFound').style.display = 'block';
  }
</script>
</body>
</html>
